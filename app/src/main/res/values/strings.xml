    <!-- About -->
    <string name="about_version">Version %1$s</string>
    <string name="about_intro">SMS Forwarder captures the text messages your phone receives and forwards them to your Telegram, so you can read them anywhere — even when you\'re away from the phone. Just sign in, bind your Telegram, and start the service; leave the phone plugged in at home and your SMS follow you.</string>
    <string name="about_disclaimer_title">Disclaimer</string>
    <string name="about_disclaimer">For personal use. The app reads your SMS only to forward them to the destination you set up; message contents are relayed, not kept on the server. You are responsible for complying with local laws and for the security of your own account and server. Provided as-is, without any warranty.</string>
